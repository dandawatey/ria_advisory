# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ufip
PGUSER=postgres
PGPASSWORD=your_password_here

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Leave blank to use defaults (localhost + https://i-finsights.netlify.app)
ALLOWED_ORIGINS=https://i-finsights.netlify.app,http://localhost:5173

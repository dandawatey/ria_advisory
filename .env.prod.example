# .env.prod.example — Production environment variables for i-CFO360
# Copy to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod to git (it is in .gitignore).
# IC-48 | Neha_DevOps_006

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
PGHOST=                    # e.g. 127.0.0.1 (local) or RDS endpoint
PGPORT=5432
PGDATABASE=ria_advisory
PGUSER=                    # production DB user (not postgres superuser)
PGPASSWORD=                # strong password (min 24 chars)

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=                # 64-char hex string — MUST be unique per environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://your-domain.com

# ── Azure AD (SSO) ────────────────────────────────────────────────────────────
# Register a new App in Azure portal for production (separate from dev)
VITE_AZURE_CLIENT_ID=      # Azure App Registration Client ID
VITE_AZURE_TENANT_ID=      # Azure AD Tenant ID (or "common" for multi-tenant)
VITE_AZURE_REDIRECT_URI=https://your-domain.com

# ── BC Sync Worker ────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15   # How often to sync Business Central GL data

# ── Deployment ────────────────────────────────────────────────────────────────
GIT_SHA=                   # Set by CI/CD to docker image tag (git rev-parse --short HEAD)
